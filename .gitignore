# ========================================
# Security / Credentials
# ========================================
# Never commit keys, certificates, etc.
*.pem
*.key
*.crt
*.p12
*.pfx

# Sensitive Django files
**/settings/local.py
**/settings/dev.py
**/settings/production.py  # if it contains secrets

